# Skopiuj do .env i dostosuj. Wszystkie wartości są opcjonalne.

# Port serwera
PORT=3000

# Publiczny adres aplikacji (do linków z zaproszeniami i kalendarza .ics)
# PUBLIC_URL=https://korki.twoja-domena.pl

# Ustaw, gdy aplikacja stoi za reverse proxy (Caddy, nginx, Cloudflare Tunnel)
# TRUST_PROXY=1

# Stały kod pierwszej konfiguracji (domyślnie losowany i wypisywany w logach)
# SETUP_CODE=

# Maksymalny rozmiar wgrywanego pliku w MB
# MAX_UPLOAD_MB=25

# Katalog na bazę danych i pliki (w Dockerze: /data)
# DATA_DIR=./data
